[gd_resource type="Resource" script_class="ShopData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/core/shop_data.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
id = &"seed_shop"
display_name = "Seed Shop (placeholder)"
stock = Array[StringName]([&"turnip_seeds", &"carrot_seeds", &"tomato_seeds", &"pumpkin_seeds", &"waxweed_starter"])
seasonal_seeds = true
buys_from_player = true
